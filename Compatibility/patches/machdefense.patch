+// UIKit image contexts are bitmap contexts with a top-left origin.
+// MachDefense uses these APIs when rotating its original unit thumbnails.
+pub fn UIGraphicsBeginImageContext(env: &mut Environment, size: CGSize) {
+    if !size.width.is_finite() || !size.height.is_finite() || size.width <= 0.0 || size.height <= 0.0 {
+        UIGraphicsPushContext(env, nil);
+        return;
+    }
+    let color_space = CGColorSpaceCreateDeviceRGB(env);
+    let context = CGBitmapContextCreate(env, Ptr::null(), size.width.ceil() as u32,
+        size.height.ceil() as u32, 8, 0, color_space, kCGImageAlphaPremultipliedLast);
+    CGColorSpaceRelease(env, color_space);
+    CGContextTranslateCTM(env, context, 0.0, size.height);
+    CGContextScaleCTM(env, context, 1.0, -1.0);
+    UIGraphicsPushContext(env, context);
+    CGContextRelease(env, context);
+}
+
+pub fn UIGraphicsGetImageFromCurrentImageContext(env: &mut Environment) -> id {
+    let context = UIGraphicsGetCurrentContext(env);
+    if context == nil { return nil; }
+    let cg_image = CGBitmapContextCreateImage(env, context);
+    let image: id = msg_class![env; UIImage imageWithCGImage:cg_image];
+    CGImageRelease(env, cg_image);
+    image
+}
+
+pub fn UIGraphicsEndImageContext(env: &mut Environment) {
+    if !env.framework_state.uikit.ui_graphics.context_stack.is_empty() { UIGraphicsPopContext(env); }
+}
+
 pub const FUNCTIONS: FunctionExports = &[
