+(env, this, _cmd);
+@implementation ADBannerView: UIView
+- (id)initWithCoder:(id)coder {
+    let this: id = msg_super![env; this initWithCoder:coder];
+    () = msg![env; this setHidden:true];
+    this
+}
+- (())setDelegate:(id)delegate {
+    env.framework_state.iad_delegates.insert(this, delegate);
+}
+- (id)delegate {
+    env.framework_state.iad_delegates.get(&this).copied().unwrap_or(nil)
+}
+- (bool)isBannerLoaded { false }
+- (bool)bannerLoaded { false }
+- (bool)isBannerViewActionInProgress { false }
+- (())cancelBannerViewAction {}
+- (())dealloc {
+    env.framework_state.iad_delegates.remove(&this);
+    msg_super![env; this dealloc]
+}
+@end
