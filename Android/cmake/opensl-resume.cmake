# Android-only fix for vendored OpenAL Soft's stop/start buffer ownership.
# Keep the shared third-party source unchanged for existing Apple consumers.
set(_opensl_original "${MD_ROOT}/Modules/ThirdParty/openal-soft/alc/backends/opensl.cpp")
file(SHA256 "${_opensl_original}" _opensl_sha)
if(NOT _opensl_sha STREQUAL "ecb13bda3baf76c64ab3e00bf5b7c40d3aa4d9f2bda5a9058ff023f53bc80f36")
    message(FATAL_ERROR "OpenSL source changed; recheck the Android resume fix")
endif()
file(READ "${_opensl_original}" _opensl_text)
# stop() joins its mixer before clearing the ring. start() reuses that ring.
string(REPLACE "        mRing.reset();" "        mRing->reset();" _opensl_fixed "${_opensl_text}")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/android-backend")
set(_opensl_output "${CMAKE_CURRENT_BINARY_DIR}/android-backend/opensl.cpp")
file(WRITE "${_opensl_output}" "${_opensl_fixed}")
get_target_property(_openal_sources OpenAL SOURCES)
set(_android_openal_sources "")
foreach(_source IN LISTS _openal_sources)
    if(_source MATCHES "alc/backends/opensl.cpp$")
        list(APPEND _android_openal_sources "${_opensl_output}")
    elseif(IS_ABSOLUTE "${_source}")
        list(APPEND _android_openal_sources "${_source}")
    else()
        list(APPEND _android_openal_sources "${MD_ROOT}/Modules/ThirdParty/openal-soft/${_source}")
    endif()
endforeach()
set_property(TARGET OpenAL PROPERTY SOURCES "${_android_openal_sources}")
target_include_directories(OpenAL PRIVATE "${MD_ROOT}/Modules/ThirdParty/openal-soft/alc/backends")
target_compile_options(OpenAL PRIVATE -O2)
