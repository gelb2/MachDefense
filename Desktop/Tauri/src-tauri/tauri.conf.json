{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MachDefense Desktop",
  "version": "0.7.0",
  "identifier": "com.gelb2.machdefense.desktop",
  "build": {
    "frontendDist": "../build/frontend",
    "beforeBuildCommand": "python3 scripts/prepare.py"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
